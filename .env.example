# Everything here is optional. Anything missing, juke asks for in a setup
# form the first time you open it, and saves to JUKE_DATA_DIR. Values set
# here always win over the form.

# Navidrome juke talks to. Jukebox control is admin-only by default, so
# this account is normally a Navidrome admin.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=
# The password itself, or NAVIDROME_PASSWORD_FILE with a path to a file
# holding it.
NAVIDROME_PASSWORD=
NAVIDROME_PASSWORD_FILE=

# What juke calls the speakers: "Playing on Living room".
JUKE_NAME=
# Password each device enters once. Leave unset and anyone who can reach
# juke can use it. JUKE_PASSWORD_FILE also works.
JUKE_PASSWORD=

# Turns on Ask (songs from your library for a request in plain words),
# billed to your own Anthropic account. ANTHROPIC_API_KEY_FILE also works.
ANTHROPIC_API_KEY=
# Claude model Ask uses. Default: claude-opus-5-5.
ANTHROPIC_MODEL=

# Where juke keeps its settings file.
JUKE_DATA_DIR=./data
# Port the proxy listens on. In dev, Vite proxies /api here.
JUKE_PORT=4600
# Dev only: other hostnames allowed to reach the Vite dev server, comma-separated.
JUKE_DEV_HOSTS=
