# Navidrome the proxy talks to. Jukebox control is admin-only by default,
# so this account must be a Navidrome admin.
NAVIDROME_URL=http://galactus:4533
NAVIDROME_USER=bryan
# Either a path to a file holding the password (preferred; what the NixOS
# module uses) or the password itself for local dev.
NAVIDROME_PASSWORD_FILE=
NAVIDROME_PASSWORD=
# Port the proxy listens on. In dev, Vite proxies /api here.
JUKE_PORT=4600
